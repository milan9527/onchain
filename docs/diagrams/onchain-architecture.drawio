        </mxCell>
        <mxCell id="fail" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFF2F3;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="1430" width="1160" height="150" as="geometry" />
        </mxCell>
        <mxCell id="fail-title" value="任一安全检查失败：阻止执行，不扣款" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=17;fontColor=#C5354A;fontStyle=1;spacing=0;" vertex="1" parent="fail">
          <mxGeometry x="20" y="12" width="1120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="fail-body" value="越权 / 会话串用 / 非法工具参数 / 意图变更 / 过期授权 / 超额 / 滑点不满足 → 拒绝并记录。&lt;br&gt;一分钟内至少 3 次严重越权事件可触发 Agent 暂停与 epoch 递增。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="fail">
          <mxGeometry x="20" y="51" width="1120" height="90" as="geometry" />
        </mxCell>
        <mxCell id="return" value="" style="rounded=1;arcSize=8;html=1;fillColor=#F0F8F6;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1430" width="1180" height="150" as="geometry" />
        </mxCell>
        <mxCell id="return-title" value="用户行为可控，认证返回与执行结果可追踪" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=17;fontColor=#087F75;fontStyle=1;spacing=0;" vertex="1" parent="return">
          <mxGeometry x="20" y="12" width="1140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="return-body" value="Gateway 输出过滤不替代成交前校验；模型没有批准工具，OAuth scope 也不等于交易批准。&lt;br&gt;定投只在用户已确认的 grant 范围内运行；暂停、撤销或删除后，旧凭据不能继续执行。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="return">
          <mxGeometry x="20" y="51" width="1140" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
