        </mxCell>
        <mxCell id="denial-body" value="不以资源 ID、模型指令或 IAM 服务角色替代用户授权。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="denial">
