          <mxGeometry x="60" y="1490" width="1170" height="150" as="geometry" />
        </mxCell>
        <mxCell id="bound-claims-title" value="短期签名绑定与后台强制检查" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=17;fontColor=#087F75;fontStyle=1;spacing=0;" vertex="1" parent="bound-claims">
          <mxGeometry x="20" y="12" width="1130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="bound-claims-body" value="owner + conversation + runtime_sid + Agent epoch + Skill digest + run&lt;br&gt;工具执行上下文再绑定 tool + arguments_hash；篡改、过期或权限撤销均拒绝。&lt;br&gt;同一 AWS 服务角色只表示服务身份，用户权限由签名上下文与当前状态共同决定。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="bound-claims">
          <mxGeometry x="20" y="51" width="1130" height="90" as="geometry" />
        </mxCell>
        <mxCell id="revoke-history" value="" style="rounded=1;arcSize=8;html=1;fillColor=#F0F8F6;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1270" y="1490" width="1180" height="150" as="geometry" />
        </mxCell>
        <mxCell id="revoke-history-title" value="删除 / 撤销后的行为" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=17;fontColor=#087F75;fontStyle=1;spacing=0;" vertex="1" parent="revoke-history">
          <mxGeometry x="20" y="12" width="1140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="revoke-history-body" value="删除 Agent：标记 DELETED、递增 epoch、撤销 grants、取消 PENDING / APPROVED 操作。&lt;br&gt;旧 capability、旧 MCP 连接与排队执行无法恢复权限；历史保留只读。&lt;br&gt;会话与运行默认保留 30 天；用户身份从 Cognito 获取，模型不能选择 owner。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="revoke-history">
          <mxGeometry x="20" y="51" width="1140" height="90" as="geometry" />
        </mxCell>
