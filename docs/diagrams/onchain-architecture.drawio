        <mxCell id="seller-retention" value="A 不能读取 / 删除 B 的 Agent、Session、run 或订单。&lt;br&gt;共享 Runtime 部署不等于共享会话或权限。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;fontColor=#147EBA;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="105" y="1345" width="580" height="80" as="geometry" />
        </mxCell>
        <mxCell id="buyer-retention" value="B 不继承卖家会话、授权 grant、钱包或密钥。&lt;br&gt;卖家下架不会改变已售任务的买方批准范围。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;fontColor=#8C4FFF;fontStyle=0;spacing=0;" vertex="1" parent="1">
