        <mxCell id="seller-data-detail" value="USER#A：Agents / operations / grants / paper wallet&lt;br&gt;SESSION：每条记录带 owner，读取时校验&lt;br&gt;HISTORY#A#agent_id / RUN#A#conversation#run&lt;br&gt;卖家可见自己的收入与销售订单&lt;br&gt;不返回买方 Agent、钱包、会话或运行数据" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;fontColor=#69788A;fontStyle=0;spacing=0;" vertex="1" parent="seller-data">
