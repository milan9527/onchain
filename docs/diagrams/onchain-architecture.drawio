        </mxCell>
        <mxCell id="denial-title" value="跨 owner / 跨 Session 请求 → DENY" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=17;fontColor=#C5354A;fontStyle=1;spacing=0;" vertex="1" parent="denial">
