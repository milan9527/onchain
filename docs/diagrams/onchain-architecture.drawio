        </mxCell>
        <mxCell id="shared-executor-detail" value="验证 audience=onchain-tools、工具名与 arguments_hash&lt;br&gt;依据签名 owner 查找资源，不信任模型或客户端传入的身份&lt;br&gt;重读 Agent 状态 / epoch / 用户批准 / grant / 预算&lt;br&gt;交易只修改当前 owner 的状态；重复执行返回同一回执&lt;br&gt;市场服务费的双边事务仅由已确认的购买流程处理" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;fontColor=#69788A;fontStyle=0;spacing=0;" vertex="1" parent="shared-executor">
